{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "Asia/Shanghai",
  "schedule": [
    "every day"
  ],
  "argocd": {
    "fileMatch": [
      "^argocd/apps/.+\\.ya?ml$",
      "^argocd/bootstrap/.+\\.ya?ml$"
    ]
  },
  "kubernetes": {
    "fileMatch": [
      "^argocd/configs/.+\\.ya?ml$"
    ]
  },
  "kustomize": {
    "fileMatch": [
      "(^|/)kustomization\\.ya?ml$"
    ]
  },
  "assignees": ["L128"],
  "labels": ["dependencies", "renovate"],
  "packageRules": [
    {
      "description": "自动合并小版本 (minor)、补丁版本 (patch) 及 digest/pin 更新",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": true
    },
    {
      "description": "大版本 (major) 更新可能会有 Breaking Changes，仅提 PR 供人工 Review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major-update", "needs-review"]
    }
  ]
}
