// Tailscale tailnet policy. Git is the source of truth.
// Applied by .github/workflows/tailscale-acl.yml.
// Replaces the default allow-all grant. SSH check rule is unchanged.
{
	// Admins own tag:k8s-operator so the operator OAuth client can be created
	// after this file is applied. The operator then owns proxy and router tags.
	// Connector/langshi-ha (hostname langshi-ha-router) uses tag:ha-router
	// and advertises the Home Assistant, DNS, NAS, and Mac Studio host routes.
	// Dedicated no-SNAT subnet router VM tailscale-router (192.168.50.140,
	// homelab-pve vms/tailscale-router.tf + homelab-ansible tailscale-router role).
	// It joins with an admin-owned OAuth client carrying only this tag.
	// The router now carries 192.168.50.230/32 so Traefik sees grokbot-box's real IP.
	"tagOwners": {
		"tag:k8s-operator": ["autogroup:admin"],
		"tag:k8s":          ["tag:k8s-operator"],
		"tag:ha-router":    ["tag:k8s-operator"],
		"tag:subnet-router-nosnat": ["autogroup:admin"],
		"tag:grokbot":      ["autogroup:admin"],
		"tag:codex":        ["autogroup:admin"],
	},

	// grokbot-box is the tag:grokbot box node. If /workspace/.grokbot-tailscale-state
	// is lost and it rejoins, reassign the new node's IPv4 to 100.102.152.24 in
	// the admin console (Machines > ... > Edit IP address) and delete the old node;
	// Traefik trusted-client routes, this ACL and UniFi then need no change.
	"hosts": {
		"grokbot-box": "100.102.152.24",
	},

	"autoApprovers": {
		"routes": {
			"192.168.50.120/32": ["tag:ha-router"],
			"192.168.50.231/32": ["tag:ha-router"],
			"192.168.50.102/32": ["tag:ha-router"],
			"192.168.50.79/32":  ["tag:ha-router"],
			"192.168.50.230/32": ["tag:subnet-router-nosnat"],
		},
	},

	"grants": [
		// The only member (the owner) reaches his own devices, the cluster
		// tags, and Langshi Home Assistant on every protocol and port.
		{
			"src": ["autogroup:member"],
			"dst": [
				"autogroup:member",
				"tag:k8s-operator",
				"tag:k8s",
				"tag:ha-router",
				"192.168.50.120/32",
			],
			"ip": ["*"],
		},

		// Tagged nodes reach each other and Home Assistant. They do not reach
		// member devices; that is the break from the old "* -> *" grant.
		{
			"src": ["tag:k8s-operator", "tag:k8s", "tag:ha-router"],
			"dst": [
				"tag:k8s-operator",
				"tag:k8s",
				"tag:ha-router",
				"192.168.50.120/32",
			],
			"ip": ["*"],
		},

		// Each destination has its own ports; do not add grokbot to broad grants.
		{
			"src": ["tag:grokbot"],
			"dst": ["192.168.50.231/32"],
			"ip":  ["tcp:53", "udp:53"],
		},
		{
			"src": ["tag:grokbot"],
			"dst": ["192.168.50.102/32"],
			"ip":  ["tcp:445", "tcp:443"],
		},
		{
			"src": ["tag:grokbot"],
			"dst": ["192.168.50.120/32"],
			"ip":  ["tcp:80"],
		},
		// Traefik websecure VIP. 8443 only.
		{
			"src": ["tag:grokbot"],
			"dst": ["192.168.50.230/32"],
			"ip":  ["tcp:8443"],
		},
		// Mac Studio SSH jump for box relay → macmini4. Port 22 only.
		{
			"src": ["tag:grokbot"],
			"dst": ["192.168.50.79/32"],
			"ip":  ["tcp:22"],
		},
		{
			"src": ["tag:codex"],
			"dst": ["192.168.50.120/32"],
			"ip":  ["tcp:80"],
		},
	],

	// Define users and devices that can use Tailscale SSH.
	"ssh": [
		// Allow all users to SSH into their own devices in check mode.
		// Comment this section out if you want to define specific restrictions.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	// 443 is a stand-in port. The grants allow every protocol and port.
	// The member login is the only user on this tailnet (role: owner).
	"tests": [
		{
			"src":   "tb6hjbk4vr@privaterelay.appleid.com",
			"proto": "tcp",
			"accept": [
				"192.168.50.120:80",
				"tag:k8s:443",
				"tag:k8s-operator:443",
			],
		},
		{
			"src":   "tag:ha-router",
			"proto": "tcp",
			// The user expands to every device signed in as the only member.
			// 100.98.102.109 is omarchy, an untagged member device.
			"deny": [
				"tb6hjbk4vr@privaterelay.appleid.com:22",
				"100.98.102.109:22",
			],
		},
		{
			"src":   "tag:grokbot",
			"proto": "tcp",
			"accept": ["192.168.50.231:53", "192.168.50.102:445", "192.168.50.102:443", "192.168.50.120:80", "192.168.50.79:22", "192.168.50.230:8443"],
			"deny": ["192.168.50.1:22", "192.168.50.102:22", "192.168.50.231:5380", "192.168.50.120:22", "192.168.50.120:445", "192.168.50.120:8123", "192.168.50.102:53", "192.168.50.79:80", "192.168.50.79:443", "192.168.50.79:445", "192.168.50.230:80", "192.168.50.230:443", "192.168.50.230:22"],
		},
		{
			"src": "grokbot-box",
			"proto": "tcp",
			"accept": ["192.168.50.230:8443"],
			"deny": ["192.168.50.230:80"],
		},
		{
			"src": "tag:grokbot",
			"proto": "udp",
			"accept": ["192.168.50.231:53"],
			"deny": ["192.168.50.102:53", "192.168.50.231:445"],
		},
		{
			"src": "tag:k8s",
			"proto": "tcp",
			"deny": ["tag:grokbot:22"],
		},
		{
			"src": "tag:subnet-router-nosnat",
			"proto": "tcp",
			"deny": ["192.168.50.120:80", "192.168.50.231:53", "100.102.152.24:22"],
		},
	],
}
