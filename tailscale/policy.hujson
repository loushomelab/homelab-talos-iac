// Tailscale tailnet policy. Git is the source of truth.
// Applied by .github/workflows/tailscale-acl.yml.
// Replaces the default allow-all grant. SSH check rule is unchanged.
{
	// Admins own tag:k8s-operator so the operator OAuth client can be created
	// after this file is applied. The operator then owns proxy and router tags.
	// The live k8s Connector uses tag:ha-router; tag:lan-router is its
	// same-privilege successor for a follow-up rename PR. Both tags may advertise
	// the Home Assistant, DNS, NAS, Mac Studio, and Traefik VIP host routes.
	"tagOwners": {
		"tag:k8s-operator": ["autogroup:admin"],
		"tag:k8s":          ["tag:k8s-operator"],
		"tag:ha-router":    ["tag:k8s-operator"],
		"tag:lan-router":   ["tag:k8s-operator"],
		"tag:grokbot":      ["autogroup:admin"],
		"tag:codex":        ["autogroup:admin"],
	},

	// grokbot-box is the tag:grokbot box node. If /workspace/.grokbot-tailscale-state
	// is lost and it rejoins, reassign the new node's IPv4 to 100.102.152.24 in
	// the admin console (Machines > ... > Edit IP address) and delete the old node;
	// Traefik trusted-client routes, this ACL and UniFi then need no change.
	"hosts": {
		"grokbot-box": "100.102.152.24",
		// macmini6 is Lou's untagged member device (MagicDNS
		// macmini6.taildc7b98.ts.net, IPv4 100.68.158.4). The alias is the
		// IPv4 address because the destinations below are IPv4. If the node
		// rejoins and gets a new IPv4, update this line; the grants stay
		// the same. Do not tag this node: tagging would drop it from
		// autogroup:member and take away existing member grants.
		"macmini6": "100.68.158.4",
	},

	"autoApprovers": {
		"routes": {
			"192.168.50.120/32": ["tag:ha-router", "tag:lan-router"],
			"192.168.50.231/32": ["tag:ha-router", "tag:lan-router"],
			"192.168.50.102/32": ["tag:ha-router", "tag:lan-router"],
			"192.168.50.79/32":  ["tag:ha-router", "tag:lan-router"],
			"192.168.50.230/32": ["tag:ha-router", "tag:lan-router"],
		},
	},

	"grants": [
		// The only member (the owner) reaches his own devices, the cluster
		// tags, and Langshi Home Assistant on every protocol and port.
		{
			"src": ["autogroup:member"],
			"dst": [
				"autogroup:member",
				"tag:k8s-operator",
				"tag:k8s",
				"tag:ha-router",
				"tag:lan-router",
				"192.168.50.120/32",
			],
			"ip": ["*"],
		},

		// Tagged nodes reach each other and Home Assistant. They do not reach
		// member devices; that is the break from the old "* -> *" grant.
		{
			"src": ["tag:k8s-operator", "tag:k8s", "tag:ha-router", "tag:lan-router"],
			"dst": [
				"tag:k8s-operator",
				"tag:k8s",
				"tag:ha-router",
				"tag:lan-router",
				"192.168.50.120/32",
			],
			"ip": ["*"],
		},

		// Each destination has its own ports; do not add grokbot to broad grants.
		{
			"src": ["tag:grokbot"],
			"dst": ["192.168.50.231/32"],
			"ip":  ["tcp:53", "udp:53"],
		},
		{
			"src": ["tag:grokbot"],
			"dst": ["192.168.50.102/32"],
			"ip":  ["tcp:445", "tcp:443"],
		},
		{
			"src": ["tag:grokbot"],
			"dst": ["192.168.50.120/32"],
			"ip":  ["tcp:80"],
		},
		// Traefik websecure VIP 8443 and Forgejo git SSH (Traefik TCP 22).
		{
			"src": ["tag:grokbot"],
			"dst": ["192.168.50.230/32"],
			"ip":  ["tcp:8443", "tcp:22"],
		},
		// Mac Studio SSH jump for box relay → macmini4. Port 22 only.
		{
			"src": ["tag:grokbot"],
			"dst": ["192.168.50.79/32"],
			"ip":  ["tcp:22"],
		},
		{
			"src": ["tag:codex"],
			"dst": ["192.168.50.120/32"],
			"ip":  ["tcp:80"],
		},
		// Owner SSH into the tag:grokbot box. Port 22 only. Named user, not
		// autogroup:member, so a later additional member does not inherit this.
		{
			"src": ["tb6hjbk4vr@privaterelay.appleid.com"],
			"dst": ["tag:grokbot"],
			"ip":  ["tcp:22"],
		},
		// macmini6 (untagged, Lou-owned). Forgejo git SSH and Traefik
		// websecure only; no other LAN ports. Do not use autogroup:member
		// here: that would also open .230 to omarchy, qcloud, and the rest.
		{
			"src": ["macmini6"],
			"dst": ["192.168.50.230/32"],
			"ip":  ["tcp:8443", "tcp:22"],
		},
		// macmini6 SSH jump to Mac Studio (→ macmini4 on LAN). Port 22 only;
		// macmini4 itself is not routed into the tailnet.
		{
			"src": ["macmini6"],
			"dst": ["192.168.50.79/32"],
			"ip":  ["tcp:22"],
		},
		// Split DNS for 646499453.xyz (Technitium at .231) is tailnet-wide
		// and is not stored in this policy file. tag:grokbot already has
		// :53. Members and tag:codex need it too, or those clients would
		// fail to resolve the domain once split DNS is enabled. Technitium
		// recursion stays LAN-only (192.168.50.0/23); the k8s subnet router SNATs
		// tailnet queries onto the LAN.
		{
			"src": ["autogroup:member", "tag:codex"],
			"dst": ["192.168.50.231/32"],
			"ip":  ["tcp:53", "udp:53"],
		},
	],

	// Define users and devices that can use Tailscale SSH.
	"ssh": [
		// Allow all users to SSH into their own devices in check mode.
		// Comment this section out if you want to define specific restrictions.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
		// Owner to the tag:grokbot box user only. accept matches the
		// requested grant; the existing self rule stays check.
		{
			"action": "accept",
			"src":    ["tb6hjbk4vr@privaterelay.appleid.com"],
			"dst":    ["tag:grokbot"],
			"users":  ["box"],
		},
	],

	// 443 is a stand-in port. The grants allow every protocol and port.
	// The member login is the only user on this tailnet (role: owner).
	"tests": [
		{
			"src":   "tb6hjbk4vr@privaterelay.appleid.com",
			"proto": "tcp",
			"accept": [
				"192.168.50.120:80",
				"tag:k8s:443",
				"tag:k8s-operator:443",
				"tag:grokbot:22",
			],
		},
		{
			"src":   "tag:ha-router",
			"proto": "tcp",
			// The user expands to every device signed in as the only member.
			// 100.98.102.109 is omarchy, an untagged member device.
			"deny": [
				"tb6hjbk4vr@privaterelay.appleid.com:22",
				"100.98.102.109:22",
			],
		},
		{
			"src":   "tag:lan-router",
			"proto": "tcp",
			"deny": [
				"tb6hjbk4vr@privaterelay.appleid.com:22",
				"100.98.102.109:22",
			],
		},
		{
			"src":   "tag:grokbot",
			"proto": "tcp",
			"accept": ["192.168.50.231:53", "192.168.50.102:445", "192.168.50.102:443", "192.168.50.120:80", "192.168.50.79:22", "192.168.50.230:8443", "192.168.50.230:22"],
			"deny": ["192.168.50.1:22", "192.168.50.102:22", "192.168.50.231:5380", "192.168.50.120:22", "192.168.50.120:445", "192.168.50.120:8123", "192.168.50.102:53", "192.168.50.79:80", "192.168.50.79:443", "192.168.50.79:445", "192.168.50.230:80", "192.168.50.230:443"],
		},
		{
			"src": "grokbot-box",
			"proto": "tcp",
			"accept": ["192.168.50.230:8443"],
			"deny": ["192.168.50.230:80"],
		},
		{
			"src": "tag:grokbot",
			"proto": "udp",
			"accept": ["192.168.50.231:53"],
			"deny": ["192.168.50.102:53", "192.168.50.231:445"],
		},
		{
			"src": "tag:k8s",
			"proto": "tcp",
			"deny": ["tag:grokbot:22"],
		},
		{
			"src":   "macmini6",
			"proto": "tcp",
			"accept": ["192.168.50.230:22", "192.168.50.230:8443", "192.168.50.231:53", "192.168.50.79:22"],
			"deny": ["192.168.50.230:80", "192.168.50.230:443", "192.168.50.231:5380", "192.168.50.102:445", "192.168.50.79:80", "192.168.50.79:445", "192.168.50.89:22"],
		},
		{
			"src":   "macmini6",
			"proto": "udp",
			"accept": ["192.168.50.231:53"],
			"deny": ["192.168.50.102:53"],
		},
		// omarchy is an untagged member device. It gets Technitium :53 for
		// split DNS, but not Forgejo on the Traefik VIP.
		{
			"src":   "100.98.102.109",
			"proto": "tcp",
			"accept": ["192.168.50.231:53"],
			"deny": ["192.168.50.230:22", "192.168.50.230:8443"],
		},
		{
			"src":   "tag:codex",
			"proto": "tcp",
			"accept": ["192.168.50.231:53", "192.168.50.120:80"],
			"deny": ["192.168.50.230:22", "192.168.50.230:8443"],
		},
		{
			"src":   "tag:codex",
			"proto": "udp",
			"accept": ["192.168.50.231:53"],
		},
	],
}
